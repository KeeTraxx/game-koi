---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';
// The script that drives this page lives in its own file so the block below shows
// the code that is actually running, not a copy that can drift out of date.
import source from '../../scripts/threejs-example.ts?raw';
---

<StarlightPage
	frontmatter={{
		title: 'Three.js scene',
		description: 'The emulator’s canvas, used as a live texture in a Three.js scene.',
	}}
>
	<p>
		The <a href="../rom-player/">ROM player</a> puts the emulator on a canvas you
		look at directly. This page never shows that canvas: it hands it to Three.js as a
		texture and maps it onto the screen of a model you can spin around. The emulator
		does not know the difference — it draws 160&times;144 pixels into a canvas exactly
		as before, and something else decides what those pixels become.
	</p>

	<p>
		Same "bring your own ROM" deal as the other page, and the same keyboard controls
		(arrows, <kbd>Z</kbd>, <kbd>X</kbd>, <kbd>Enter</kbd>, right <kbd>Shift</kbd>) —
		they are bound to the window, not the canvas, so a hidden canvas still plays.
		Drag to orbit, scroll to zoom.
	</p>

	<div class="controls">
		<input type="file" accept=".gb" id="rom" />
		<span id="status">ready — choose a ROM (.gb)</span>
	</div>

	<canvas id="scene" width="640" height="480"></canvas>

	<!-- The emulator's real output. Hidden: it exists to be read as a texture. -->
	<canvas id="gb" width="160" height="144" hidden></canvas>

	<h2>The code</h2>

	<p>
		The whole example is one script. It expects the three elements above on the page:
		<code>#rom</code> (the file input), <code>#status</code>, and two canvases —
		<code>#scene</code> for Three.js and the hidden <code>#gb</code> that the emulator
		draws into.
	</p>

	<Code code={source} lang="ts" title="threejs-example.ts" />
</StarlightPage>

<style>
	#gb {
		display: none;
	}
	.controls {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-bottom: 0.75rem;
	}

	#status {
		font-family: var(--__sl-font-mono, monospace);
		font-size: var(--sl-text-sm);
	}

	#scene {
		display: block;
		width: 100%;
		max-width: 640px;
		height: auto;
		aspect-ratio: 4 / 3;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.25rem;
		touch-action: none;
	}
</style>

<script>
	import '../../scripts/threejs-example.ts';
</script>
